package pages

import (
	"encoding/json"

	"github.com/Napam/chatwego"
	"github.com/Napam/chatwego/db/generated/sqlc"
	"github.com/Napam/chatwego/lib/agent"
	"github.com/Napam/chatwego/lib/htmlclass"
	"github.com/Oudwins/tailwind-merge-go/pkg/twmerge"
)

// storedToolCalls reconstructs an assistant message's tool calls (and their
// results, from the "tool" rows looked up in results by tool_call_id) for
// display, from the JSON blob persisted in chat_messages.tool_calls.
func storedToolCalls(msg sqlc.ChatMessage, results map[string]string) []agent.ToolCallRecord {
	if !msg.ToolCalls.Valid {
		return nil
	}
	var stored []agent.StoredToolCall
	if err := json.Unmarshal([]byte(msg.ToolCalls.String), &stored); err != nil {
		return nil
	}
	records := make([]agent.ToolCallRecord, len(stored))
	for i, tc := range stored {
		records[i] = agent.ToolCallRecord{StoredToolCall: tc, Result: results[tc.ID]}
	}
	return records
}

const (
	ChatMessagesID = "chat-messages"
	ChatTextareaID = "chat-textarea"
	SessionListID  = "session-list"
	StopButtonID   = "stop-button"
	ChatFormID     = "chat-form"
)

// Signals is the reactive state the root page starts with. sessionId tells
// the server which session a prompt belongs to; the server patches it when
// the first prompt creates a session. draft is the composer text.
// hasMessages hides the welcome placeholder once a conversation starts.
// Everything else the page needs is client-only: the sidebar and breakpoint
// signals are created by the page's data-init, and the leading underscore
// keeps them out of request payloads.
type Signals struct {
	SessionID   string `json:"sessionId"`
	Draft       string `json:"draft"`
	HasMessages bool   `json:"hasMessages"`
}

templ RootPage(currentSessionID string, chatSessions []sqlc.ChatSession, messages []sqlc.ChatMessage) {
	{{
		signalsJSON, _ := templ.JSONString(Signals{
			SessionID:   currentSessionID,
			HasMessages: len(messages) > 0,
		})
		// Top bar shows the open chat's title, falling back to the app name.
		pageTitle := "ChatWeGo"
		for _, sess := range chatSessions {
			if sess.ID == currentSessionID && sess.Title.String != "" {
				pageTitle = sess.Title.String
			}
		}
	}}
	<html>
		<head>
			<title>{ pageTitle }</title>
			<link rel="stylesheet" id="tailwindcss" href={ chatwego.StaticRootPath("static/tailwind.css") }/>
			<script src={ chatwego.StaticRootPath("static/bundle.js") }></script>
			<script type="module" src={ chatwego.StaticRootPath("static/assets/vendor/datastar.js") }></script>
		</head>
		<body
			class="h-dvh w-dvw overflow-hidden bg-white text-gray-700 dark:bg-neutral-900 dark:text-neutral-300"
			data-signals={ signalsJSON }
			data-signals:_controller="new AbortController()"
			data-init="
				$_mdQuery = '(min-width: 768px)';
				$_sidebarWide = window.matchMedia($_mdQuery).matches;
				$_sidebarOpen = false;
				$_sidebarCollapsed = false;
				$_sidebarAnimating = false;
			"
			data-on:resize__window="
				const wide = window.matchMedia($_mdQuery).matches;
				if (wide === $_sidebarWide) return;
				$_sidebarWide = wide;
				// Close the mobile drawer on the way in to md. The desktop column
				// is md:translate-x-0, so this has no visual effect. The drawer
				// transition is only on during a user toggle, so the transform
				// change at the breakpoint cannot animate.
				if (wide) $_sidebarOpen = false;
			"
		>
			<div class="flex">
				<!-- Scrim: tapping it closes the mobile drawer. The desktop sidebar
				     pushes the content, so it needs no scrim. -->
				<div
					class="fixed inset-0 z-30 bg-black/40 md:hidden"
					style="display: none"
					data-show="$_sidebarOpen"
					data-on:click="
						$_sidebarAnimating = true;
						$_sidebarOpen = false;
						setTimeout(() => $_sidebarAnimating = false, 250);
					"
					aria-hidden="true"
				></div>
				<!-- Sidebar: off-canvas drawer below md, in-flow column at md and up.
				     _sidebarOpen is the mobile drawer and _sidebarCollapsed is the
				     desktop collapse. Each changes only on the side of the breakpoint
				     where it has no visual effect, and md:translate-x-0 pins the
				     desktop column in flow. The transform transition exists only
				     while _sidebarAnimating is set by a user toggle, so the transform
				     change at a breakpoint has no transition to run. -->
				<aside
					id="sidebar"
					class="dark:bg-neutral-850 fixed inset-y-0 left-0 z-40 flex h-dvh w-72 shrink-0 -translate-x-full flex-col overflow-hidden bg-gray-50 font-bold md:static md:translate-x-0 md:transition-none"
					data-class="{ 'translate-x-0': $_sidebarOpen, 'md:w-0': $_sidebarCollapsed, 'md:invisible': $_sidebarCollapsed, 'transition-transform': $_sidebarAnimating, 'duration-200': $_sidebarAnimating, 'ease-in-out': $_sidebarAnimating }"
				>
					<div class="flex h-full w-72 shrink-0 flex-col">
						<div class="dark:border-neutral-750 flex h-12 shrink-0 items-center justify-between border-b border-gray-200 px-4">
							Chats
							<div class="flex items-center gap-3">
								<a
									href="/admin"
									class="text-xs font-normal text-gray-400 hover:underline dark:text-neutral-500"
								>
									Admin
								</a>
								<theme-button></theme-button>
								<button
									type="button"
									aria-label="Close chat list"
									class="dark:text-neutral-400 dark:hover:bg-neutral-700 dark:active:bg-neutral-600 flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-gray-500 hover:bg-gray-200 active:bg-gray-300 md:hidden"
									data-on:click="
										$_sidebarAnimating = true;
										$_sidebarOpen = false;
										setTimeout(() => $_sidebarAnimating = false, 250);
									"
								>
									<x-icon svgClass="size-5"></x-icon>
								</button>
							</div>
						</div>
						<div class="scrollbar-thin scrollbar-gutter-stable scrollbar-thumb-black/25 scrollbar-track-transparent dark:scrollbar-thumb-white/20 min-h-0 flex-1 overflow-y-auto overscroll-contain">
							@SessionList(currentSessionID, chatSessions)
						</div>
					</div>
				</aside>
				<main class="relative flex h-dvh w-full flex-col items-center justify-between p-3 pb-4 md:p-4 md:pb-8 dark:bg-neutral-900">
					<!-- Top bar: floats over the messages at every width so they scroll
					     under it, with a faded edge instead of a hard clip. Its button
					     toggles the sidebar at every size. -->
					<header class="pointer-events-none absolute inset-x-0 top-0 z-20">
						<div class="absolute inset-x-0 top-0 h-12 bg-white/90 backdrop-blur-sm dark:bg-neutral-900/90"></div>
						<div class="absolute inset-x-0 top-12 h-6 bg-gradient-to-b from-white to-transparent dark:from-neutral-900"></div>
						<div class="pointer-events-auto relative flex w-full items-center px-3 py-3">
							<button
								type="button"
								aria-label="Toggle chat list"
								class="flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-lg text-gray-600 hover:bg-gray-100 active:bg-gray-200 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:active:bg-neutral-700"
								data-on:click="
									if ($_sidebarWide) {
										$_sidebarCollapsed = !$_sidebarCollapsed;
									} else {
										$_sidebarAnimating = true;
										$_sidebarOpen = !$_sidebarOpen;
										setTimeout(() => $_sidebarAnimating = false, 250);
									}
								"
							>
								<menu-icon svgClass="size-5"></menu-icon>
							</button>
							<span class="absolute top-1/2 left-1/2 max-w-[60%] -translate-x-1/2 -translate-y-1/2 truncate text-sm font-semibold text-gray-800 dark:text-neutral-200">{ pageTitle }</span>
						</div>
					</header>
					<div
						id={ ChatMessagesID }
						class="scrollbar-thin scrollbar-gutter-stable scrollbar-thumb-black/25 scrollbar-track-transparent dark:scrollbar-thumb-white/20 mb-4 flex w-full max-w-220 flex-1 flex-col gap-6 overflow-y-auto overscroll-contain pt-15 md:mb-8 md:gap-8"
					>
						if currentSessionID == "" {
							@WelcomePlaceholder()
						}
						{{
							// "tool" rows fold into the preceding assistant round's tool-calls display.
							toolResults := make(map[string]string, len(messages))
							for _, msg := range messages {
								if msg.Type == "tool" {
									toolResults[msg.ToolCallID.String] = msg.Content.String
								}
							}
						}}
						for _, msg := range messages {
							switch msg.Type {
								case "user":
									@ChatContainer(MessageBubble{Message: msg.Content.String, ChatType: ChatTypeQuestion})
								case "assistant":
									@ChatContainer(MessageBubble{
										Message:   msg.Content.String,
										ChatType:  ChatTypeAnswer,
										Reasoning: msg.Reasoning.String,
										ToolCalls: storedToolCalls(msg, toolResults),
									})
							}
						}
					</div>
					<script defer src={ chatwego.StaticRootPath("static/page-files/pages/root.js") }></script>
					<form
						id={ ChatFormID }
						class="flex w-full max-w-xl gap-2"
						data-on:submit="
							window.answering = true;
							$_controller.abort();
							$_controller = new AbortController();
							@post('/send-prompt', { requestCancellation: $_controller, retry: 'never' });
							$draft = '';
							!window.matchMedia($_mdQuery).matches && ($_sidebarOpen = false);
						"
					>
						<div class="relative w-full">
							<textarea
								id={ ChatTextareaID }
								class={ htmlclass.Join(
								"w-full rounded-xl p-4 pr-12 border border-gray-300",
								"dark:bg-neutral-800 dark:border-neutral-600",
								"focus:outline-primary-400 focus:outline-2 focus:outline-solid",
							) }
								placeholder="Message ChatWeGo..."
								data-bind="draft"
								data-on:keydown="evt.key === 'Enter' && !evt.shiftKey && !evt.isComposing && (evt.preventDefault(), !window.answering && $draft.trim() && el.form.requestSubmit())"
							></textarea>
							<button
								type="button"
								id={ StopButtonID }
								title="Stop generating"
								aria-label="Stop generating"
								class={ htmlclass.Join(
								"hidden absolute right-3 bottom-3 size-8 cursor-pointer items-center justify-center rounded-lg",
								"text-gray-500 hover:bg-gray-100 active:bg-gray-200",
								"dark:text-neutral-400 dark:hover:bg-neutral-700 dark:active:bg-neutral-600",
							) }
								data-on:click="window.answering && ($_controller.abort(), document.getElementById('chat-textarea')?.focus())"
							>
								<span class="block size-3 rounded-xs bg-current"></span>
							</button>
						</div>
					</form>
				</main>
			</div>
		</body>
	</html>
}

templ SessionList(currentSessionID string, chatSessions []sqlc.ChatSession) {
	{{
		sessionsLiClasses := htmlclass.Join(
			"w-full cursor-pointer truncate rounded-sm text-sm font-normal",
			"hover:bg-gray-200 dark:hover:bg-neutral-700",
		)
		sessionsLinkClasses := "block truncate px-2 py-2"
	}}
	<ol class="flex flex-col gap-1 p-2" id={ SessionListID }>
		<li class={ sessionsLiClasses }>
			<a class={ sessionsLinkClasses } href="/">+ New</a>
		</li>
		for _, sess := range chatSessions {
			if sess.ID == currentSessionID {
				<li class={ twmerge.Merge(sessionsLiClasses, "bg-gray-200 font-medium dark:bg-neutral-750") }>
					<span class={ sessionsLinkClasses }>{ sess.Title.String }</span>
				</li>
			} else {
				<li class={ sessionsLiClasses }>
					<a class={ sessionsLinkClasses } href={ templ.URL("/chats/" + sess.ID) }>{ sess.Title.String }</a>
				</li>
			}
		}
	</ol>
}

templ WelcomePlaceholder() {
	{{
		suggestions := []string{
			"Write me a long story that showcases markdown rendering",
			"Show me a code snippet with syntax highlighting",
			"Give me a markdown table comparing two things",
			"Make me a checklist with a few tasks",
		}
	}}
	<div
		id="welcome-placeholder"
		class="flex h-full flex-col items-center justify-center gap-3 text-center font-normal"
		data-show="!$hasMessages"
	>
		<h1 class="text-xl font-semibold text-gray-800 dark:text-neutral-200">
			What can I help you with?
		</h1>
		<p class="max-w-sm text-sm text-gray-500 dark:text-neutral-400">
			Ask me anything, or try one of these to get started.
		</p>
		<div class="mt-2 flex max-w-lg flex-wrap justify-center gap-2">
			for _, suggestion := range suggestions {
				<button
					type="button"
					class={
						htmlclass.Join(
							"cursor-pointer rounded-full border border-gray-200 px-3 py-1.5 text-sm text-gray-600",
							"hover:bg-gray-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800",
						),
					}
					data-on:click="$draft = el.textContent.trim(); document.getElementById('chat-textarea')?.focus()"
				>
					{ suggestion }
				</button>
			}
		</div>
	</div>
}

type ChatType int

const (
	ChatTypeAnswer = iota
	ChatTypeQuestion
)

const (
	reasoningSummaryClass = "flex w-fit cursor-pointer list-none items-center gap-1 text-sm text-gray-400 select-none hover:text-gray-600 dark:text-neutral-600 dark:hover:text-neutral-400 [&::-webkit-details-marker]:hidden"
	// Tool-call args/results stay plain text (raw blobs, not prose), so the
	// muted styling lives here; max-h-80 scrolls long traces in-block.
	toolCallBodyClass = "my-1 max-h-80 overflow-y-auto border-l-2 border-gray-200 pl-3 text-sm whitespace-pre-wrap text-gray-400 dark:border-neutral-700 dark:text-neutral-500"
	// Wrapper only: border, spacing, and the max-h-80 scroll cap -- the muted
	// markdown-message inside supplies palette and size.
	reasoningBodyClass = "my-1 max-h-80 overflow-y-auto border-l-2 border-gray-200 pl-3 dark:border-neutral-700"
)

// ReasoningBlock renders the collapsed-by-default "Thoughts" disclosure --
// subtle since reasoning is a secondary detail -- auto-expanding when the
// round produced no reply text. Reasoning is markdown via <markdown-message muted>.
//
// Live (reasoningID != ""): a hidden accumulator span (the SSE swap target,
// escaped server-side so inert) feeds the markdown-message, which re-parses
// as deltas land. The summary doubles as the round's loading indicator --
// pulsing "Thinking ..." until reply text or tool calls arrive, then
// "Thoughts" -- with open/hidden/label state driven by the RootPage script
// (see syncThoughts).
// Static: render directly, open set server-side, omitted if empty.
templ ReasoningBlock(reasoning string, reasoningID string, open bool) {
	if reasoningID != "" {
		<details class="group" data-live-thoughts>
			<summary class={ reasoningSummaryClass }>
				<span class="inline-block text-base transition-transform group-open:rotate-90">▸</span>
				<span data-thinking-label class="animate-pulse">Thinking ...</span>
				<span data-thoughts-label class="hidden">Thoughts</span>
			</summary>
			<div class={ reasoningBodyClass } data-reasoning-body>
				<span id={ reasoningID } class="hidden" data-reasoning-accumulator></span>
				<markdown-message muted source={ reasoningID }></markdown-message>
			</div>
		</details>
	} else if reasoning != "" {
		<details open?={ open } class="group mb-2">
			<summary class={ reasoningSummaryClass }>
				<span class="inline-block text-base transition-transform group-open:rotate-90">▸</span>
				Thoughts
			</summary>
			<div class={ reasoningBodyClass }>
				<markdown-message muted>{ reasoning }</markdown-message>
			</div>
		</details>
	}
}

// ToolCallEntries renders one subtle disclosure per tool call (arguments +
// result). Live rounds inject the whole exchange at once -- tools run
// synchronously, so there's nothing to stream; reloads render statically.
templ ToolCallEntries(calls []agent.ToolCallRecord) {
	for _, call := range calls {
		<details class="group">
			<summary class={ reasoningSummaryClass }>
				<span class="inline-block text-base transition-transform group-open:rotate-90">▸</span>
				{ "Called " + call.Name }
			</summary>
			<div class={ toolCallBodyClass }>
				if call.Arguments != "" && call.Arguments != "{}" {
					<div>Arguments: { call.Arguments }</div>
				}
				<div>Result: { call.Result }</div>
			</div>
		</details>
	}
}

// ToolCallsBlock renders a round's tool calls, styled like ReasoningBlock.
// Live (toolCallsID != ""): placeholder div, injected wholesale via one SSE
// patch. Static: render calls directly, omitted if none.
templ ToolCallsBlock(calls []agent.ToolCallRecord, toolCallsID string) {
	if toolCallsID != "" {
		<div id={ toolCallsID } class="mb-2 flex flex-col gap-1" data-tool-calls></div>
	} else if len(calls) > 0 {
		<div class="mb-2 flex flex-col gap-1">
			@ToolCallEntries(calls)
		</div>
	}
}

// MessageBubble is the render-time data for one chat bubble. A live streaming
// bubble uses ID/ReasoningID/ToolCallsID as patch-target names (content fields
// zero); a stored bubble is the reverse.
type MessageBubble struct {
	Message     string
	ChatType    ChatType
	ID          string
	ReasoningID string
	Reasoning   string
	ToolCallsID string
	ToolCalls   []agent.ToolCallRecord
}

templ ChatContainer(bubble MessageBubble) {
	{{
		classes := "mr-0 ml-auto w-fit max-w-lg animate-fade-in rounded-xl rounded-tr-none bg-gray-100 p-4 dark:bg-neutral-800"
		if bubble.ChatType == ChatTypeAnswer {
			classes = "w-full animate-fade-in"
		}
	}}
	<div class={ classes }>
		switch bubble.ChatType {
			case ChatTypeAnswer:
				if bubble.ID != "" {
					// Live bubbles only: the Thoughts disclosure's summary doubles as
					// the loading indicator (see ReasoningBlock and syncThoughts).
					@ReasoningBlock("", bubble.ReasoningID, false)
					@ToolCallsBlock(nil, bubble.ToolCallsID)
					// Hidden patch target for streamed deltas, left untouched by markdown-message.
					<span id={ bubble.ID } class="hidden" data-markdown-source></span>
					<markdown-message source={ bubble.ID }></markdown-message>
				} else {
					// No reply text -> expand thoughts, since they're the only content.
					@ReasoningBlock(bubble.Reasoning, "", bubble.Message == "")
					@ToolCallsBlock(bubble.ToolCalls, "")
					<markdown-message>{ bubble.Message }</markdown-message>
				}
			default:
				{ bubble.Message }
		}
	</div>
}
